# Copie para .env.local (não vai para o Git) para gerar builds locais com métricas, ex.: npm run build:itch.
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.
# Sem elas o jogo funciona normalmente, só sem métricas e relatórios de erro.

# PostHog → Project settings → Project API key (chave pública, começa com phc_)
VITE_POSTHOG_KEY=
# https://us.i.posthog.com (EUA) ou https://eu.i.posthog.com (Europa)
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Sentry → Project settings → Client Keys (DSN)
VITE_SENTRY_DSN=
